# Normalize line endings to LF in the repository.
# Windows checkouts will still use CRLF locally (core.autocrlf = true),
# but the stored objects and diffs will always be LF-only.
* text=auto eol=lf

# Force LF for source files regardless of platform.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.mdc  text eol=lf
*.env* text eol=lf

# Treat binary files as binary (no line-ending conversion).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
