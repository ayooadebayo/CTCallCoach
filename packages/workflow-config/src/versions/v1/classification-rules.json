    },
    "output_path": "PD6",
    "is_overlay": true,
    "confidence": "high"
  },
  {
    "rule_code": "CR_007_OVERLAY",
    "description": "Add PD7 overlay when any vulnerability signal is detected",
    "conditions": {
      "vulnerability_detected": true
    },
    "output_path": "PD7",
    "is_overlay": true,
    "confidence": "high"
  },
  {
    "rule_code": "CR_008",
