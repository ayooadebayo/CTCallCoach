{
  "name": "@ctcc/content-bundles",
  "version": "0.0.1",
  "description": "Versioned guidance content — public policy summaries, Acme operations guidance, wording templates, support options, and warnings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@ctcc/shared-schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
